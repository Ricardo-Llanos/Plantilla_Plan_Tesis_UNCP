% --- FORMATO DE LEYENDAS (Figuras y Tablas) ---
\captionsetup[figure]{
    labelfont={bf,small},         
    textfont={it,small},  
    labelsep=newline,             
    justification=raggedright,    
    singlelinecheck=false,
    position=top
}

\captionsetup[table]{
    labelfont={bf,small},         
    textfont={it,small},  
    labelsep=newline,             
    justification=raggedright,    
    singlelinecheck=false,
    position=top
}

% --- AUTOMATIZACIÓN DE ENTORNO FLOATING CON [H] COMPACTO POR DEFECTO ---
\makeatletter
\renewenvironment{table}[1][H] 
  {\@float{table}[#1]\singlespacing\fontsize{10pt}{12pt}\selectfont}
  {\end@float}

\renewenvironment{figure}[1][H]
  {\@float{figure}[#1]\singlespacing\fontsize{10pt}{12pt}\selectfont}
  {\end@float}
\makeatother

% --- ENTORNO EXCLUSIVO PARA NOTAS DE TABLAS/FIGURAS ---
\newenvironment{notatabla}{
    \par\vspace{0.2cm}
    \justifying
    \fontsize{9pt}{11pt}\selectfont 
}{
    \par
}

